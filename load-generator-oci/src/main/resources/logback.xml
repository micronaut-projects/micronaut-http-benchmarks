<configuration>
    <conversionRule conversionWord="uptime" converterClass="io.micronaut.benchmark.loadgen.oci.UptimeConverter"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <withJansi>true</withJansi>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <encoder>
            <pattern>%cyan(+%uptime) %gray([%X{benchmarkName}]) %highlight(%-5level) %magenta(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>output/log</file>
        <append>false</append>
        <encoder>
            <pattern>+%uptime [%X{benchmarkName}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
    </root>

    <logger name="org.apache.sshd.client.keyverifier.AcceptAllServerKeyVerifier" level="ERROR"/>
    <logger name="org.apache.sshd.common.forward.DefaultForwarder" level="ERROR"/>
    <logger name="org.apache.sshd.client.channel.ClientChannelPendingMessagesQueue" level="ERROR"/>
    <logger name="com.oracle.bmc.core.model.InstanceShapeConfig$BaselineOcpuUtilization" level="ERROR"/>
    <logger name="com.oracle.bmc.core.model.Image$ListingType" level="ERROR"/>
    <logger name="com.oracle.bmc" level="WARN"/>
    <logger name="com.oracle.bmc.core.VirtualNetworkClient" level="ERROR"/>
    <logger name="com.oracle.bmc.core.model.InstanceShapeConfig$ResourceManagement" level="ERROR"/>
    <logger name="com.oracle.bmc.objectstorage.ObjectStorageClient" level="ERROR"/>
</configuration>
