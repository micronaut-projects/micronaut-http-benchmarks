<configuration>
    <conversionRule conversionWord="uptime" converterClass="io.micronaut.benchmark.loadgen.oci.UptimeConverter"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <withJansi>true</withJansi>
        <encoder>
            <pattern>%cyan(+%uptime) %gray([%X{benchmarkName}]) %highlight(%-5level) %magenta(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="info">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
