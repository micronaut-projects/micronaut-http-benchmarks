#!/usr/bin/env bash
set -eu

cd "$APP_DIR"

gunicorn --worker-class gevent --workers 6 --worker-connections 10000 --backlog 8192 --http-protocols h1 --no-control-socket --bind 0.0.0.0:8080 app:app &
http_pid=$!
gunicorn --worker-class gevent --workers 6 --worker-connections 10000 --backlog 8192 --http-protocols h2 --no-control-socket --certfile cert.pem --keyfile key.pem --bind 0.0.0.0:8443 app:app &
https_pid=$!

shutdown() {
  trap - EXIT INT TERM
  kill "$http_pid" "$https_pid" 2>/dev/null || true
  wait "$http_pid" "$https_pid" 2>/dev/null || true
}
trap shutdown EXIT INT TERM

attempt=0
while [ "$attempt" -lt 300 ]; do
  if ! kill -0 "$http_pid" 2>/dev/null || ! kill -0 "$https_pid" 2>/dev/null; then
    exit 1
  fi
  if curl --fail --silent --output /dev/null http://127.0.0.1:8080/status \
    && curl --fail --silent --insecure --http2 --output /dev/null https://127.0.0.1:8443/status; then
    systemd-notify --ready
    break
  fi
  attempt=$((attempt + 1))
  sleep 1
done

if [ "$attempt" -eq 300 ]; then
  exit 1
fi

while kill -0 "$http_pid" 2>/dev/null && kill -0 "$https_pid" 2>/dev/null; do
  sleep 1
done
exit 1
