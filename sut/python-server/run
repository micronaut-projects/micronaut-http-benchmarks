#!/usr/bin/env bash
set -eu

cd "$APP_DIR"

case "$PYTHON_SERVER" in
  gunicorn)
    args=(--workers 6 --worker-connections 10000 --backlog 8192 --no-control-socket)
    if [ "$PYTHON_INTERFACE" = wsgi ]; then
      args+=(--worker-class gevent)
    else
      args+=(--worker-class asgi --asgi-loop "$PYTHON_EVENT_LOOP")
    fi
    # Only this launcher announces readiness after probing both listeners.
    env -u NOTIFY_SOCKET gunicorn "${args[@]}" --http-protocols h1 --bind 0.0.0.0:8080 "$PYTHON_APPLICATION" &
    http_pid=$!
    env -u NOTIFY_SOCKET gunicorn "${args[@]}" --http-protocols h2 --certfile cert.pem --keyfile key.pem --bind 0.0.0.0:8443 "$PYTHON_APPLICATION" &
    https_pid=$!
    ;;
  granian)
    args=(--interface "$PYTHON_INTERFACE" --host 0.0.0.0 --workers 6 --workers-kill-timeout 10 --backlog 8192)
    if [ "$PYTHON_INTERFACE" != wsgi ]; then
      args+=(--loop "$PYTHON_EVENT_LOOP")
    fi
    env -u NOTIFY_SOCKET granian "${args[@]}" --http 1 --port 8080 "$PYTHON_APPLICATION" &
    http_pid=$!
    env -u NOTIFY_SOCKET granian "${args[@]}" --http 2 --port 8443 --ssl-certificate cert.pem --ssl-keyfile key.pem --ssl-protocol-min tls1.2 "$PYTHON_APPLICATION" &
    https_pid=$!
    ;;
  *)
    echo "Unknown Python server: $PYTHON_SERVER" >&2
    exit 1
    ;;
esac

shutdown() {
  trap - EXIT INT TERM
  kill "$http_pid" "$https_pid" 2>/dev/null || true
  wait "$http_pid" "$https_pid" 2>/dev/null || true
}
trap shutdown EXIT
trap 'exit 0' INT TERM

attempt=0
while [ "$attempt" -lt 120 ]; do
  if ! kill -0 "$http_pid" 2>/dev/null || ! kill -0 "$https_pid" 2>/dev/null; then
    exit 1
  fi
  if curl --fail --silent --max-time 2 --output /dev/null http://127.0.0.1:8080/status \
    && [ "$(curl --fail --silent --max-time 2 --insecure --http2 --output /dev/null --write-out '%{http_version}' https://127.0.0.1:8443/status)" = 2 ]; then
    systemd-notify --ready
    break
  fi
  attempt=$((attempt + 1))
  sleep 1
done

if [ "$attempt" -eq 120 ]; then
  exit 1
fi

while kill -0 "$http_pid" 2>/dev/null && kill -0 "$https_pid" 2>/dev/null; do
  sleep 1
done
exit 1
