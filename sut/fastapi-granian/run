#!/usr/bin/env bash
set -eu

cd "$APP_DIR"

# Bound shutdown even if a worker does not finish draining its connections.
granian --interface asgi --loop uvloop --http 1 --host 0.0.0.0 --port 8080 --workers 6 --workers-kill-timeout 10 --backlog 8192 app:app &
http_pid=$!
granian --interface asgi --loop uvloop --http 2 --host 0.0.0.0 --port 8443 --workers 6 --workers-kill-timeout 10 --backlog 8192 --ssl-certificate cert.pem --ssl-keyfile key.pem --ssl-protocol-min tls1.2 app:app &
https_pid=$!

shutdown() {
  trap - EXIT INT TERM
  kill "$http_pid" "$https_pid" 2>/dev/null || true
  wait "$http_pid" "$https_pid" 2>/dev/null || true
}
trap shutdown EXIT
trap 'exit 0' INT TERM

attempt=0
while [ "$attempt" -lt 120 ]; do
  if ! kill -0 "$http_pid" 2>/dev/null || ! kill -0 "$https_pid" 2>/dev/null; then
    exit 1
  fi
  if curl --fail --silent --max-time 2 --output /dev/null http://127.0.0.1:8080/status \
    && [ "$(curl --fail --silent --max-time 2 --insecure --http2 --output /dev/null --write-out '%{http_version}' https://127.0.0.1:8443/status)" = 2 ]; then
    systemd-notify --ready
    break
  fi
  attempt=$((attempt + 1))
  sleep 1
done

if [ "$attempt" -eq 120 ]; then
  exit 1
fi

while kill -0 "$http_pid" 2>/dev/null && kill -0 "$https_pid" 2>/dev/null; do
  sleep 1
done
exit 1
