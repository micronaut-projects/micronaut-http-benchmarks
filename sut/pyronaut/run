#!/usr/bin/env bash
set -eu

"$PYRONAUT_DEPLOYABLE" &
server_pid=$!

terminate() {
  trap - INT TERM
  kill "$server_pid" 2>/dev/null || true
  if wait "$server_pid"; then
    server_status=0
  else
    server_status=$?
  fi
  exit "$server_status"
}

trap terminate INT TERM

attempt=0
while [ "$attempt" -lt 300 ]; do
  if "$CURL" --fail --silent --output /dev/null http://127.0.0.1:8080/status; then
    systemd-notify --ready
    wait "$server_pid"
    exit $?
  fi
  if ! kill -0 "$server_pid" 2>/dev/null; then
    wait "$server_pid"
    exit $?
  fi
  attempt=$((attempt + 1))
  sleep 1
done

kill "$server_pid"
wait "$server_pid"
